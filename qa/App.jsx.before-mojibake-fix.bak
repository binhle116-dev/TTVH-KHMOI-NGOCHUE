      { wch: 22 },
      { wch: 12 },
      { wch: 28 },
      { wch: 14 },
      { wch: 24 },
      { wch: 28 },
      { wch: 26 },
    ]
    XLSX.writeFile(workbook, 'danh_sach_bg_chua_co_thong_tin_phat.xlsx')
  }

  return (
    <article className="panel risk-panel">
      <div className="risk-head">
        <div>
          <h2>ÄÃNH GIÃ Tá»’N PHÃT & CHÆ¯A CÃ“ THÃ”NG TIN PHÃT</h2>
